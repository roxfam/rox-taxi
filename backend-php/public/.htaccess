# ─── Rox Taxi — Namecheap Stellar routing ────────────────────────────────
# 1. `/api/*` requests → api/index.php (handled by api/.htaccess)
# 2. Everything else (SPA routes) → index.html so React Router owns them
# 3. Deny direct access to hidden files, .env, and lib.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force HTTPS (Namecheap AutoSSL provides the cert)
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # If a real file/dir exists (index.html, static/, uploads/, api/, robots.txt),
    # serve it directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Anything else = React SPA route (Home, Taxi, Tours, Gallery, Admin, …)
    RewriteRule . /index.html [L]
</IfModule>

# Long cache for hashed React build assets
<IfModule mod_headers.c>
    <FilesMatch "\.(?:css|js|woff2?|ttf|otf|eot|jpg|jpeg|png|webp|gif|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Never cache index.html — deploys must be picked up immediately
    <Files "index.html">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </Files>
</IfModule>

# Deny direct access to sensitive files
<FilesMatch "^(\.env|\.htaccess|composer\.(json|lock)|rox\.env)$">
    Require all denied
</FilesMatch>

# Gzip
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
